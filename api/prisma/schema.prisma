generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  DELETED
}

enum OrganizationType {
  GYM
  TRAINER_BUSINESS
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  TRAINER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
}

enum RelationshipStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum AccessScope {
  VIEW_TRAINING
  START_SESSION
  LOG_SETS
  MANAGE_ASSIGNMENTS
  VIEW_BODYWEIGHT
}

enum InvitationType {
  MEMBERSHIP
  CLIENT_RELATIONSHIP
}

enum AuditActorType {
  USER
  OPERATOR
}

model User {
  id                  String                       @id @default(uuid()) @db.Char(36)
  legacyUid           String?                      @db.VarChar(128)
  legacyUidHash       String?                      @unique @db.Char(64)
  displayName         String?                      @db.VarChar(120)
  status              UserStatus                   @default(ACTIVE)
  createdAt           DateTime                     @default(now()) @db.DateTime(3)
  updatedAt           DateTime                     @updatedAt @db.DateTime(3)
  platformAdmin       PlatformAdmin?
  memberships         OrganizationMembership[]
  enrollments         ClientOrganizationEnrollment[]
  trainerRelationships TrainerClientRelationship[] @relation("RelationshipTrainer")
  clientRelationships TrainerClientRelationship[] @relation("RelationshipClient")
  createdInvitations  OrganizationInvitation[]     @relation("InvitationCreator")
  acceptedInvitations OrganizationInvitation[]     @relation("InvitationAcceptor")
  invitationTrainer   OrganizationInvitation[]     @relation("InvitationTrainer")
  grantedAccess       ClientAccessGrant[]           @relation("GrantActor")
  revokedAccess       ClientAccessGrant[]           @relation("GrantRevoker")
  auditAsActor        AuditEvent[]                  @relation("AuditActor")
  auditAsTarget       AuditEvent[]                  @relation("AuditTarget")
}

model PlatformAdmin {
  userId    String   @id @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  grantedBy String   @db.VarChar(128)
  grantedAt DateTime @default(now()) @db.DateTime(3)
}

model Organization {
  id           String                       @id @default(uuid()) @db.Char(36)
  type         OrganizationType
  name         String                       @db.VarChar(120)
  slug         String                       @unique @db.VarChar(80)
  status       OrganizationStatus           @default(ACTIVE)
  createdAt    DateTime                     @default(now()) @db.DateTime(3)
  updatedAt    DateTime                     @updatedAt @db.DateTime(3)
  memberships  OrganizationMembership[]
  enrollments  ClientOrganizationEnrollment[]
  relationships TrainerClientRelationship[]
  invitations  OrganizationInvitation[]
  auditEvents  AuditEvent[]
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @db.Char(36)
  userId         String           @db.Char(36)
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @db.DateTime(3)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}

model ClientOrganizationEnrollment {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @db.Char(36)
  clientUserId   String           @db.Char(36)
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now()) @db.DateTime(3)
  endedAt        DateTime?        @db.DateTime(3)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client         User            @relation(fields: [clientUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, clientUserId])
  @@index([clientUserId, status])
}

model TrainerClientRelationship {
  id             String             @id @default(uuid()) @db.Char(36)
  organizationId String             @db.Char(36)
  trainerUserId  String             @db.Char(36)
  clientUserId   String             @db.Char(36)
  status         RelationshipStatus @default(PENDING)
  createdAt      DateTime           @default(now()) @db.DateTime(3)
  acceptedAt     DateTime?          @db.DateTime(3)
  revokedAt      DateTime?          @db.DateTime(3)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  trainer        User              @relation("RelationshipTrainer", fields: [trainerUserId], references: [id], onDelete: Restrict)
  client         User              @relation("RelationshipClient", fields: [clientUserId], references: [id], onDelete: Restrict)
  grants         ClientAccessGrant[]

  @@unique([organizationId, trainerUserId, clientUserId])
  @@index([clientUserId, status])
  @@index([trainerUserId, organizationId, status])
}

model ClientAccessGrant {
  id                String                    @id @default(uuid()) @db.Char(36)
  relationshipId    String                    @db.Char(36)
  scope             AccessScope
  grantedByUserId   String                    @db.Char(36)
  grantedAt         DateTime                  @default(now()) @db.DateTime(3)
  expiresAt         DateTime                  @db.DateTime(3)
  revokedAt         DateTime?                 @db.DateTime(3)
  revokedByUserId   String?                   @db.Char(36)
  relationship      TrainerClientRelationship @relation(fields: [relationshipId], references: [id], onDelete: Restrict)
  grantedBy         User                      @relation("GrantActor", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy         User?                     @relation("GrantRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([relationshipId, scope, revokedAt])
  @@index([expiresAt])
}

model OrganizationInvitation {
  id                String         @id @default(uuid()) @db.Char(36)
  organizationId    String         @db.Char(36)
  type              InvitationType
  role              MembershipRole?
  trainerUserId     String?        @db.Char(36)
  targetLegacyUid   String?        @db.VarChar(128)
  targetLegacyUidHash String?       @db.Char(64)
  createdByUserId   String         @db.Char(36)
  createdByPlatformAdmin Boolean   @default(false)
  acceptedByUserId  String?        @db.Char(36)
  tokenHash         String         @unique @db.Char(64)
  expiresAt         DateTime       @db.DateTime(3)
  acceptedAt        DateTime?      @db.DateTime(3)
  revokedAt         DateTime?      @db.DateTime(3)
  createdAt         DateTime       @default(now()) @db.DateTime(3)
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy         User          @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  trainer           User?         @relation("InvitationTrainer", fields: [trainerUserId], references: [id], onDelete: Restrict)
  acceptedBy        User?         @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([expiresAt, acceptedAt, revokedAt])
  @@index([targetLegacyUidHash])
}

model AuditEvent {
  id               String         @id @default(uuid()) @db.Char(36)
  actorType        AuditActorType @default(USER)
  actorUserId      String?        @db.Char(36)
  actorLegacyUid   String?        @db.VarChar(128)
  actorRef         String?        @db.VarChar(128)
  targetUserId     String?        @db.Char(36)
  organizationId   String?        @db.Char(36)
  action           String         @db.VarChar(80)
  entityType       String         @db.VarChar(80)
  entityId         String?        @db.VarChar(128)
  metadata         Json?
  createdAt        DateTime       @default(now()) @db.DateTime(3)
  actor            User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target           User?          @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  organization     Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}
